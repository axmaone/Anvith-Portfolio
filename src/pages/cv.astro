---
// Shareable CV link (/cv): the visit is counted by Vercel Web Analytics as "/cv",
// then the PDF downloads. The site's own CV buttons count under the same path (see Base.astro).
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---
<Base title={`CV | ${person.name}`} description={`Download the CV of ${person.name}, ${person.role}.`}>
  <main id="main" class="cvdl">
    <div class="cvdl__card">
      <p class="mono cvdl__meta">Curriculum vitae</p>
      <h1>{person.name}</h1>
      <p class="cvdl__msg" data-msg>Your download is starting…</p>
      <div class="cvdl__ctas">
        <a class="btn" href={person.cv} download data-file>Download CV <span aria-hidden="true">↓</span></a>
        <a class="btn btn--ghost" href="/">See the portfolio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</Base>

<script is:inline>
  // give the analytics beacon a moment, then download (the download attribute keeps this page open)
  setTimeout(function () {
    var a = document.querySelector('[data-file]');
    if (a) a.click();
    var m = document.querySelector('[data-msg]');
    if (m) m.textContent = "If the download didn't start, use the button below.";
  }, 900);
</script>

<style>
  .cvdl { min-height: 100svh; display: grid; place-items: center; padding: 24px var(--gutter); }
  .cvdl__card { width: min(100%, 520px); display: grid; gap: 14px; padding: clamp(24px, 5vw, 40px); border-radius: 24px; border: 1.5px solid var(--ink); background: var(--white); box-shadow: 8px 8px 0 var(--red); }
  :global(html[data-mode='calm']) .cvdl__card { border: 1px solid rgba(255, 255, 255, 0.8); background: rgba(255, 255, 255, 0.55); backdrop-filter: blur(18px); box-shadow: 0 30px 60px -30px rgba(40, 36, 90, 0.4); }
  .cvdl__meta { margin: 0; color: var(--ink-3); }
  .cvdl h1 { margin: 0; font: 700 clamp(30px, 5vw, 44px)/1 var(--display); letter-spacing: -0.02em; }
  .cvdl__msg { margin: 0; color: var(--ink-2); }
  .cvdl__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
</style>
