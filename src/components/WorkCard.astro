---
import type { CollectionEntry } from 'astro:content';
import Art from './Art.astro';
interface Props { entry: CollectionEntry<'work'>; index: number; big?: boolean }
const { entry, index, big = false } = Astro.props;
const d = entry.data;
---
<a class={`card card--${d.accent} ${big ? 'card--big' : ''}`} href={`/work/${entry.id}/`} data-reveal>
  <div class="card__media">
    {d.cover ? (
      <img src={d.cover} alt="" loading="lazy" decoding="async" />
    ) : d.art ? <Art kind={d.art} /> : null}
    {d.video && (
      <video class="card__video" src={d.video} muted loop playsinline preload="none" poster={d.cover} aria-hidden="true"></video>
    )}
    {d.video && <span class="card__play mono"><span class="on-hover">▶ Plays on hover</span><span class="on-touch">▶ Video</span></span>}
    {d.confidential && <span class="card__badge mono">Anonymised</span>}
  </div>
  <div class="card__meta">
    <span class="mono">{String(index + 1).padStart(2, '0')} · {d.category} · {d.year}</span>
    <h3 class="card__title">{d.title}</h3>
    <p class="card__kicker">{d.kicker}</p>
    <span class="card__cta">Read the case <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .card { display: grid; gap: 18px; text-decoration: none; color: var(--ink); }
  .card__media {
    position: relative; aspect-ratio: 16 / 10; border-radius: 18px; overflow: hidden;
    border: 1.5px solid var(--ink); background: var(--paper-2);
    transition: transform 0.6s var(--ease), border-radius 0.6s var(--ease);
  }
  .card:hover .card__media { transform: rotate(-1.2deg) scale(1.01); border-radius: 40px; }
  .card__media > img, .card__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card__video { opacity: 0; transition: opacity 0.4s; }
  .card.is-playing .card__video { opacity: 1; }
  .card__play, .card__badge {
    position: absolute; left: 14px; top: 14px; padding: 6px 10px; border-radius: 999px;
    background: var(--ink); color: var(--paper); font-size: 11px;
  }
  .card__badge { left: auto; right: 14px; background: var(--red); color: var(--white); }
  .card.is-playing .card__play { opacity: 0; }
  .on-touch { display: none; }
  @media (hover: none) { .on-hover { display: none; } .on-touch { display: inline; } }
  .card__meta { display: grid; gap: 8px; }
  @media (max-width: 600px) { .card { gap: 12px; } .card__kicker { display: none; } }
  .card__meta .mono { color: var(--ink-3); }
  .card__title {
    margin: 0; font-family: var(--display); font-weight: 700; font-variation-settings: 'wdth' 84;
    font-size: clamp(24px, 2.4vw, 36px); line-height: 1; letter-spacing: -0.02em;
  }
  .card--big .card__title { font-size: clamp(30px, 3.6vw, 56px); }
  .card__kicker { margin: 0; color: var(--ink-2); max-width: 52ch; }
  .card__cta { font-weight: 600; display: inline-flex; gap: 6px; }
  .card__cta span { transition: transform 0.4s var(--ease); }
  .card:hover .card__cta span { transform: translateX(6px); }
  .card--red .card__cta { color: var(--red); }
  .card--gold .card__cta { color: #9a7220; }
  .card--sage .card__cta { color: #3f6b60; }
</style>
