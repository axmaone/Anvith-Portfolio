---
// Right-edge progress rail: where you are in the ICAD "session".
const stops = [
  { id: 'interest', n: '01', label: 'Interest' },
  { id: 'concept', n: '02', label: 'Concept' },
  { id: 'work', n: '03', label: 'Application' },
  { id: 'debrief', n: '04', label: 'Debrief' },
];
---
<nav class="rail" aria-label="Sections">
  <ol>
    {stops.map((s) => (
      <li><a href={`#${s.id}`} data-rail={s.id}><span class="rail__n">{s.n}</span><span class="rail__l">{s.label}</span></a></li>
    ))}
  </ol>
</nav>

<style>
  .rail { position: fixed; right: 14px; top: 50%; transform: translateY(-50%); z-index: 50; mix-blend-mode: difference; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .rail a { display: flex; align-items: center; gap: 8px; flex-direction: row-reverse; text-decoration: none; color: #fff; font: 11px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .rail a::after { content: ''; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid #fff; transition: background 0.3s, transform 0.3s; }
  .rail__l { opacity: 0; transform: translateX(6px); transition: opacity 0.3s, transform 0.3s; }
  .rail a:hover .rail__l, .rail a[aria-current='true'] .rail__l { opacity: 1; transform: none; }
  .rail a[aria-current='true']::after { background: #fff; transform: scale(1.3); }
  .rail__n { display: none; }
  @media (max-width: 760px) { .rail { display: none; } }
</style>
