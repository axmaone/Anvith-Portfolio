---
// The Calm version of the home page: same content as Bold, said quietly.
// Warm off-white, one typeface, a small palette, and soft glass instead of stickers and loud motion.
import type { CollectionEntry } from 'astro:content';
import Art from './Art.astro';
import MindLab from './MindLab.astro';
import MemoryGame from './MemoryGame.astro';
import { person, hero, icad, frameworks, about, journey, skills, research, writing } from '../data/site';
interface Props { work: CollectionEntry<'work'>[] }
const { work } = Astro.props;

// the Calm palette; sections, cards and roles each take one colour
const C = { indigo: '#4b47b8', coral: '#d9573a', teal: '#1f8a7d', amber: '#c0841c', sky: '#2f78c4' };
const ring = [C.indigo, C.coral, C.teal, C.amber, C.sky];
const head = (n: string, title: string, ghost: string, c: string) => ({ n, title, ghost, c });
const heads = {
  work: head('01', 'Selected work', 'Work', C.indigo),
  skills: head('02', 'Skills & tools', 'Skills', C.teal),
  exp: head('03', 'Experience', 'Path', C.coral),
  method: head('04', 'Method', 'ICAD', C.sky),
  play: head('05', 'Play', 'Play', C.amber),
  research: head('06', 'Research', 'Mind', C.indigo),
  words: head('07', 'Off the clock & words', 'Words', C.coral),
};
const orgs = ['UNext Learning', 'Manipal Academy of BFSI', 'AXMA Learning', 'Unbox Experience', 'Buoyancee', 'Aster CMI'];
// one real example per ICAD stage, from the work on this site
const icadEx = [
  'The gold-loan explainer opens on Priya’s 92-gram necklace, before a single RBI rule.',
  'Toy bricks stack hardware, hypervisor and virtual machines, each placed as it is named.',
  'Managers run simulations and role-plays in AXMA’s experiential workshops.',
  'The virtualisation summary ends on a quick check, not a recap.',
];
const icadColour = [C.coral, C.amber, C.teal, C.indigo];

// Lucide icons (ISC licence), inlined
const I: Record<string, string> = {
  brain: '<path d="M12 18V5"/><path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"/><path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"/><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"/><path d="M18 18a4 4 0 0 0 2-7.464"/><path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"/><path d="M6 18a4 4 0 0 1-2-7.464"/><path d="M6.003 5.125a4 4 0 0 0-2.526 5.77"/>',
  book: '<path d="M12 5v16"/><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z"/>',
  pencil: '<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/>',
  laptop: '<path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z"/><path d="M20.054 15.987H3.946"/>',
  paper: '<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>',
  bulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  cap: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  pen: '<path d="m18 13-.654-4.736a4 4 0 00-2.756-3.266l-9.163-2.9a2 2 0 00-2.017.493l-.82.819a2 2 0 00-.492 2.017l2.9 9.163a4 4 0 003.266 2.756L13 18"/><path d="M18.648 12.352a1.205 1.205 0 011.704 0l1.296 1.296a1.205 1.205 0 010 1.704l-6.296 6.296a1.205 1.205 0 01-1.704 0l-1.296-1.296a1.205 1.205 0 010-1.704z"/><path d="m3 3 6.586 6.586"/><circle cx="11" cy="11" r="2"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/>',
  feather: '<path d="M14.086 18.412A2 2 0 0112.67 19H5v-7.672a2 2 0 01.586-1.414L11.75 3.75a6 6 0 118.49 8.49z"/><path d="M16 8 2 22"/><path d="M17.488 15H9"/>',
};
const svg = (name: string, size = 24) => `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[name]}</svg>`;

// floating study objects around the portrait (never over the face): icon, colour, position, parallax depth
const props = [
  { i: 'brain', c: C.coral, pos: 'left: 0; top: 14%', d: 26 },
  { i: 'book', c: C.teal, pos: 'left: -3%; top: 46%', d: -18 },
  { i: 'pencil', c: C.amber, pos: 'left: 3%; bottom: 14%', d: 20 },
  { i: 'paper', c: C.sky, pos: 'right: 0; top: 8%', d: -24 },
  { i: 'laptop', c: C.indigo, pos: 'right: -4%; top: 42%', d: 16 },
  { i: 'bulb', c: C.amber, pos: 'right: 4%; bottom: 20%', d: -14 },
];
const skillMeta: Record<string, { icon: string; c: string; blurb: string }> = {
  Design: { icon: 'pen', c: C.indigo, blurb: 'How I shape learning' },
  Mind: { icon: 'brain', c: C.coral, blurb: 'The psychology underneath' },
  Room: { icon: 'users', c: C.teal, blurb: 'Facilitation and delivery' },
  Tools: { icon: 'wrench', c: C.amber, blurb: 'What I build with' },
};
---
<div class="calm calm-only">
  <div class="c-bg" aria-hidden="true">
    <span class="c-blob c-blob--1"></span><span class="c-blob c-blob--2"></span><span class="c-blob c-blob--3"></span>
  </div>
  <span class="c-progress" aria-hidden="true"><span></span></span>

  <!-- HERO -->
  <section class="c-hero c-wrap" id="c-top">
    <div class="c-hero__text">
      <p class="c-meta c-in" style="--d: 0s"><span class="c-dot"></span>{person.now}</p>
      <h1 class="c-h1" aria-label={hero.lines.join(' ')}><span class="c-line" aria-hidden="true"><span>I design how</span></span> <span class="c-line" aria-hidden="true"><span>people <span class="c-accent">{hero.lines[2]}</span></span></span></h1>
      <p class="c-lede c-in" style="--d: 0.35s">{hero.intro}</p>
      <ul class="c-keys c-in" style="--d: 0.4s" role="list">{hero.keySkills.map((s, k) => <li style={`--c: ${ring[k % ring.length]}`}>{s}</li>)}</ul>
      <div class="c-ctas c-in" style="--d: 0.45s">
        <a class="c-btn" href="#c-work">See the work <span aria-hidden="true">→</span></a>
        <a class="c-btn c-btn--ghost" href={person.cv} download data-cv>Download CV <span aria-hidden="true">↓</span></a>
      </div>
      <button class="c-hint" type="button" data-set-mode="bold">Want the full show? Switch to Bold <span aria-hidden="true">→</span></button>
    </div>
    <div class="c-hero__art" aria-hidden="true" data-c-tilt>
      <figure class="c-glass c-portrait" data-depth="6">
        <img src="/img/me-studio.webp" alt="" width="727" height="1100" />
        <figcaption><strong>{person.name}</strong><span>{person.roleLine.split(' · ').slice(0, 2).join(' · ')}</span></figcaption>
      </figure>
      {props.map((p, k) => (
        <span class="c-prop c-glass" style={`${p.pos}; --c: ${p.c}; --k: ${k}`} data-depth={p.d} set:html={svg(p.i, 26)} />
      ))}
    </div>
  </section>

  <!-- PROOF -->
  <div class="c-wrap c-proof" data-c-reveal>
    <span class="c-meta">Worked with</span>
    <ul role="list">{orgs.map((o, k) => <li style={`--c: ${ring[k % ring.length]}`}>{o}</li>)}</ul>
  </div>

  <!-- WORK -->
  <section class="c-sec c-wrap" id="c-work" style={`--sc: ${heads.work.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.work.n}</span><h2>{heads.work.title}</h2><span class="c-ghost" aria-hidden="true">{heads.work.ghost}</span></header>
    <ol class="c-work" role="list">
      {work.map((w, k) => (
        <li>
          <a class="c-row" href={`/work/${w.id}/`} style={`--rc: ${ring[k % ring.length]}`} data-c-reveal data-video={w.data.video} data-cover={w.data.cover}>
            <span class="c-row__meta">{w.data.year} · {w.data.category}{w.data.video && ' · ▶ video'}</span>
            <span class="c-row__title">{w.data.title}</span>
            <span class="c-row__kicker">{w.data.kicker}</span>
            {w.data.cover
              ? <img class="c-row__thumb" src={w.data.cover} alt="" loading="lazy" decoding="async" />
              : w.data.art && <span class="c-row__thumb c-row__art"><span class="c-row__artin"><Art kind={w.data.art} /></span></span>}
            <span class="c-row__go" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="c-preview c-glass" aria-hidden="true"><img alt="" /><video muted loop playsinline preload="none"></video><div class="c-preview__art"></div></div>
  </section>

  <!-- SKILLS: right after the proof -->
  <section class="c-sec c-wrap" id="c-skills" style={`--sc: ${heads.skills.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.skills.n}</span><h2>{heads.skills.title}</h2><span class="c-ghost" aria-hidden="true">{heads.skills.ghost}</span></header>
    <div class="c-skills">
      {skills.map((s) => {
        const m = skillMeta[s.group];
        return (
          <article class={`c-skillset c-glass ${s.group === 'Tools' ? 'c-skillset--tools' : ''}`} style={`--c: ${m.c}`} data-c-reveal>
            <header>
              <span class="c-skillset__ico" set:html={svg(m.icon, 22)} />
              <div><h3>{s.group}</h3><p>{m.blurb}</p></div>
              <span class="c-skillset__count">{s.items.length}</span>
            </header>
            <ul role="list">{s.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        );
      })}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="c-sec c-wrap" id="c-exp" style={`--sc: ${heads.exp.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.exp.n}</span><h2>{heads.exp.title}</h2><span class="c-ghost" aria-hidden="true">{heads.exp.ghost}</span></header>
    <p class="c-statement" data-c-reveal>{about.lead} <span>{about.paragraphs[0]}</span></p>
    <ul class="c-stats" role="list">
      {about.numbers.map((n, k) => <li class="c-glass" style={`--c: ${[C.coral, C.teal, C.amber, C.sky][k]}`} data-c-reveal><strong data-c-count={n.value}>{n.value}</strong><span>{n.label}</span></li>)}
    </ul>
    <ol class="c-roles" role="list">
      {journey.map((r, k) => (
        <li style={`--c: ${ring[k % ring.length]}`}>
          <details>
            <summary>
              <span class="c-roles__when">{r.when}</span>
              <span class="c-roles__title">{r.title}</span>
              <span class="c-roles__org">{r.org}{r.note && <> · <em>{r.note}</em></>}</span>
              <span class="c-roles__plus" aria-hidden="true">+</span>
            </summary>
            <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
          </details>
        </li>
      ))}
    </ol>
  </section>

  <!-- METHOD -->
  <section class="c-sec c-wrap" id="c-method" style={`--sc: ${heads.method.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.method.n}</span><h2>{heads.method.title}</h2><span class="c-ghost" aria-hidden="true">{heads.method.ghost}</span></header>
    <p class="c-statement" data-c-reveal>Every session is a four-act story. <span>ICAD is the framework I built from research on how adults actually learn, used alongside {frameworks.map((f) => f.name).join(', ').replace(/, ([^,]*)$/, ' and $1')}.</span></p>
    <ol class="c-icad" role="list">
      {icad.map((s, i) => (
        <li class="c-glass" style={`--c: ${icadColour[i]}`} data-c-reveal>
          <button type="button" class="c-icad__card" aria-expanded="false">
            <span class="c-icad__n">0{i + 1}</span>
            <strong>{s.key}</strong>
            <span class="c-icad__verb">{s.verb}</span>
            <span class="c-icad__text">{s.text}</span>
            <span class="c-icad__ex"><span><em>In my work:</em> {icadEx[i]}</span></span>
            <span class="c-icad__more" aria-hidden="true">See it in my work +</span>
          </button>
        </li>
      ))}
    </ol>
  </section>

  <!-- PLAY: the same experiments and game as Bold, dressed for Calm -->
  <section class="c-sec c-wrap" id="c-play" style={`--sc: ${heads.play.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.play.n}</span><h2>{heads.play.title}</h2><span class="c-ghost" aria-hidden="true">{heads.play.ghost}</span></header>
    <div class="c-games">
      <div class="c-glass c-games__card"><MindLab prefix="c-" /></div>
      <div class="c-glass c-games__card"><MemoryGame prefix="c-" /></div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section class="c-sec c-wrap" id="c-research" style={`--sc: ${heads.research.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.research.n}</span><h2>{heads.research.title}</h2><span class="c-ghost" aria-hidden="true">{heads.research.ghost}</span></header>
    <ol class="c-papers" role="list">
      {research.map((r, k) => <li style={`--c: ${ring[(k + 1) % ring.length]}`} data-c-reveal><span class="c-papers__ico" set:html={svg('paper', 20)} /><strong>{r.title}</strong><span>{r.text}</span></li>)}
    </ol>
  </section>

  <!-- WRITING: each line writes itself, a feather leading the ink -->
  <section class="c-sec c-wrap" id="c-words" style={`--sc: ${heads.words.c}`}>
    <header class="c-head" data-c-reveal><span class="c-num">{heads.words.n}</span><h2>{heads.words.title}</h2><span class="c-ghost" aria-hidden="true">{heads.words.ghost}</span></header>
    <ol class="c-lines" role="list">
      {writing.lines.map((l, i) => (
        <li style={`--c: ${ring[i % ring.length]}`}>
          <span class="c-lines__n">0{i + 1}</span>
          <p class="c-type" data-c-type>{l}</p>
        </li>
      ))}
    </ol>
    <p class="c-off">
      <strong>Off the clock:</strong> seven years of chess (<a href={about.offDuty[0].href} target="_blank" rel="noopener">challenge AXMA1 on chess.com ↗</a>),
      Trek Lead with Bengaluru Trekkers, and eight years of cricket.
    </p>
    <span class="c-quill" aria-hidden="true" set:html={svg('feather', 30)} />
  </section>

  <!-- CONTACT -->
  <section class="c-sec c-wrap" id="c-contact">
    <div class="c-contact c-glass" data-c-reveal>
      <span class="c-contact__ico c-glass" aria-hidden="true" set:html={svg('pencil', 28)} />
      <p class="c-meta">Contact</p>
      <h2 class="c-h2">Let's design something people <span class="c-accent">remember.</span></h2>
      <a class="c-mail" href={`mailto:${person.email}`}>{person.email}</a>
      <div class="c-ctas">
        <button class="c-btn c-btn--ghost" type="button" data-copy={person.email}>Copy email</button>
        <a class="c-btn" href={person.cv} download data-cv>Download CV <span aria-hidden="true">↓</span></a>
      </div>
      <p class="c-links">
        {person.links.linkedin && <a href={person.links.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a>}
        {person.links.instagram && <a href={person.links.instagram} rel="me noopener" target="_blank">Instagram ↗</a>}
        <span>{person.location}</span>
      </p>
    </div>
  </section>
</div>

<style>
  .calm {
    --c-bg: #f4f2ee; --c-ink: #141a23; --c-ink-2: #4d5562; --c-ink-3: #808796;
    --c-line: rgba(20, 26, 35, 0.12); --c-accent: #4b47b8;
    position: relative; isolation: isolate; color: var(--c-ink); font-family: var(--display);
  }
  .c-wrap { width: min(100% - 2 * var(--gutter), 1200px); margin-inline: auto; }

  /* soft colour fields behind everything; the glass picks them up */
  .c-bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .c-blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.75; animation: c-drift 26s ease-in-out infinite alternate; }
  .c-blob--1 { width: 46vw; height: 46vw; left: -10vw; top: -12vw; background: #cfc9ff; }
  .c-blob--2 { width: 40vw; height: 40vw; right: -12vw; top: 18vh; background: #ffd9c7; animation-delay: -8s; }
  .c-blob--3 { width: 36vw; height: 36vw; left: 30vw; bottom: -18vw; background: #c6eadf; animation-delay: -16s; }
  @keyframes c-drift { to { transform: translate(4vw, 3vh) scale(1.08); } }

  .c-glass {
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.75); border-radius: 22px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 24px 48px -28px rgba(40, 36, 90, 0.35);
  }

  .c-meta { margin: 0; font: 400 12px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-ink-3); display: flex; align-items: center; gap: 10px; }
  .c-dot { width: 8px; height: 8px; border-radius: 50%; background: #3fae6a; box-shadow: 0 0 0 4px rgba(63, 174, 106, 0.18); }
  .c-accent { color: var(--c-accent); }

  .c-btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 13px 20px; border-radius: 999px;
    font: 600 15px/1 var(--display); text-decoration: none; cursor: pointer;
    background: linear-gradient(135deg, #4b47b8, #6a5fd6); color: #fff; border: 1px solid #4b47b8; transition: background 0.25s, color 0.25s, transform 0.25s var(--ease);
  }
  .c-btn:hover { background: #d9573a; border-color: #d9573a; }
  .c-btn--ghost { background: rgba(255, 255, 255, 0.5); color: var(--c-ink); border-color: var(--c-line); backdrop-filter: blur(10px); }
  .c-btn--ghost:hover { background: #fff; color: var(--c-ink); border-color: var(--c-ink); }

  /* HERO */
  .c-hero { min-height: 88svh; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 5vw, 72px); align-items: center; padding-block: 120px 56px; }
  .c-hero__text { display: grid; gap: 22px; }
  .c-h1 { margin: 0; font-weight: 620; font-size: clamp(44px, 7vw, 104px); line-height: 0.98; letter-spacing: -0.035em; }
  .c-lede { margin: 0; max-width: 50ch; font-size: clamp(17px, 1.3vw, 20px); color: var(--c-ink-2); }
  .c-ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .c-keys { list-style: none; margin: -6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .c-keys li { font: 500 13px/1 var(--display); padding: 7px 11px; border-radius: 999px; color: var(--c); background: color-mix(in srgb, var(--c) 10%, rgba(255, 255, 255, 0.7)); border: 1px solid color-mix(in srgb, var(--c) 30%, transparent); }
  .c-hint { justify-self: start; background: none; border: 0; padding: 0; font: 500 14px var(--display); color: var(--c-ink-3); cursor: pointer; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--c-line); }
  .c-hint:hover { color: var(--c-accent); }

  .c-hero__art { position: relative; height: min(70vh, 620px); }
  .c-portrait { position: absolute; inset: 6% 8% 0 10%; margin: 0; padding: 14px 14px 0; overflow: hidden; display: grid; align-content: end; }
  .c-portrait img { position: absolute; left: 50%; bottom: 0; height: 96%; width: auto; max-width: none; translate: -50% 0; }
  .c-portrait figcaption { position: absolute; left: 14px; right: 14px; bottom: 14px; display: grid; gap: 2px; padding: 12px 14px; border-radius: 14px; background: rgba(255, 255, 255, 0.72); backdrop-filter: blur(12px); font-size: 14px; }
  .c-portrait figcaption span { font: 400 11px var(--mono); color: var(--c-ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .c-sphere { position: absolute; width: clamp(110px, 13vw, 190px); aspect-ratio: 1; border-radius: 50%; right: -2%; top: 0; z-index: 2;
