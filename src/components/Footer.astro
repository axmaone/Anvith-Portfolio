---
import { person, signOffs } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot__inner">
    <span class="foot__sig" aria-hidden="true">Anvith</span>
    <p class="foot__line" data-signoffs={JSON.stringify(signOffs)}>{signOffs[0]}</p>
    <a class="mono" href="#main">Back to top ↑</a>
  </div>
  <p class="wrap foot__small mono">© {year} {person.name} · Bengaluru</p>
</footer>

<style>
  .foot { background: var(--ink); color: var(--paper); padding-block: 28px 20px; }
  .foot__inner { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .foot__sig { font-family: var(--script); font-size: 54px; color: var(--red); line-height: 0.8; padding-top: 10px; }
  .foot__line { margin: 0; flex: 1 1 320px; font: italic 400 clamp(17px, 1.4vw, 22px)/1.3 var(--serif); transition: opacity 0.4s; }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--gold); }
  .foot__small { opacity: 0.5; margin: 16px auto 0; }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-signoffs]');
  if (el) {
    const lines: string[] = JSON.parse(el.dataset.signoffs ?? '[]');
    let i = Math.floor(Math.random() * lines.length);
    el.textContent = lines[i];
    setInterval(() => {
      el.style.opacity = '0';
      setTimeout(() => { i = (i + 1) % lines.length; el.textContent = lines[i]; el.style.opacity = '1'; }, 400);
    }, 5000);
  }
</script>
