---
// "Mind in Action": two 60-second psychology experiments, each run as a full ICAD cycle.
// Inspired by classic research; these are original demos, not the original study materials.
const words = ['bed', 'rest', 'awake', 'tired', 'dream', 'wake', 'snooze', 'blanket', 'doze', 'slumber', 'snore', 'nap', 'peace', 'yawn', 'drowsy', 'night', 'pillow', 'alarm'];
const probes = [
  { w: 'bed', seen: true }, { w: 'sleep', seen: false, lure: true }, { w: 'dream', seen: true },
  { w: 'pillow', seen: true }, { w: 'snore', seen: true }, { w: 'carrot', seen: false },
  { w: 'yawn', seen: true }, { w: 'cushion', seen: false }, { w: 'night', seen: true }, { w: 'window', seen: false },
];
const steps = ['Interest', 'Concept', 'Application', 'Debrief'];
// prefix keeps ids unique when the lab appears twice (Bold and Calm)
const { prefix = '' } = Astro.props as { prefix?: string };
---
<div class="lab" id={`${prefix}lab`} data-companion="lab" data-quiet>
  <div class="lab__head">
    <p class="mono red">Two 60-second experiments · each one is a full ICAD session</p>
    <h3 class="h-lg">Let's play. <em class="serif italic">Pick your poison.</em></h3>
    <div class="lab__tabs" role="tablist" aria-label="Choose an experiment">
      <button role="tab" aria-selected="true" aria-controls={`${prefix}exp-attention`} id={`${prefix}tab-attention`} data-tab="attention">Did you see it?</button>
      <button role="tab" aria-selected="false" aria-controls={`${prefix}exp-memory`} id={`${prefix}tab-memory`} data-tab="memory" tabindex="-1">Trust your memory?</button>
    </div>
  </div>

  {['attention', 'memory'].map((id) => (
    <div class="exp" id={`${prefix}exp-${id}`} role="tabpanel" aria-labelledby={`${prefix}tab-${id}`} data-exp={id} hidden={id !== 'attention'}>
      <ol class="exp__steps" aria-label="ICAD progress">
        {steps.map((s, i) => <li data-step-dot={i} class={i === 0 ? 'is-on' : ''}><span>{s[0]}</span>{s}</li>)}
      </ol>

      {id === 'attention' && (
        <>
          <section class="exp__panel" data-panel="0">
            <p class="exp__q">Can you miss something obvious, even when it's right in front of you?</p>
            <p>Count how many times the <strong>gold ball passes between the light players</strong>. Only completed passes count: a fake that comes back to the same player doesn't. Ignore the dark team, the bouncing balls, the holes and the lights. Keep the count in your head.</p>
            <div class="court" aria-label="An animated scene: three light players and three dark players passing balls around holes" role="img">
              {[0, 1, 2, 3, 4].map((i) => <span class="hole"></span>)}
              {[0, 1, 2].map((i) => <span class={`pl pl--l pl-l${i}`}></span>)}
              {[0, 1, 2].map((i) => <span class={`pl pl--d pl-d${i}`}></span>)}
              <span class="ball ball--l"></span><span class="ball ball--d"></span>
              {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <span class={`lite lite-${i}`}></span>)}
              {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <span class={`bnc bnc-${i}`}></span>)}
              {[0, 1, 2].map((i) => <span class={`bnc orb orb-${i}`}></span>)}
              <span class="sneak"></span>
              <button class="btn court__go" type="button" data-run>▶ Start (14 sec)</button>
            </div>
            <div class="exp__answer" hidden data-after-run>
              <label>Passes you counted <input type="number" min="0" max="40" inputmode="numeric" data-count-input /></label>
              <fieldset><legend>Anything unusual?</legend>
                <label><input type="radio" name={`${prefix}saw`} value="yes" /> Yes</label>
                <label><input type="radio" name={`${prefix}saw`} value="no" /> No</label>
              </fieldset>
              <button class="btn" type="button" data-next>Reveal <span class="arrow">→</span></button>
            </div>
          </section>
          <section class="exp__panel" data-panel="1" hidden>
            <p class="exp__big">There were <strong>13 passes</strong> (and 3 fakes). And <strong>a big yellow ball bounced straight across the court</strong>.</p>
            <p data-verdict></p>
            <p>This is <strong>inattentional blindness</strong>. When attention is busy with a demanding task, people can miss an unexpected thing that is plainly visible. Your goal decided what your brain bothered to process.</p>
            <p class="exp__cite mono">Based on Simons &amp; Chabris (1999), "Gorillas in our midst". Original demo, not the study video.</p>
            <button class="btn" type="button" data-next>Apply it <span class="arrow">→</span></button>
          </section>
          <section class="exp__panel" data-panel="2" hidden>
            <p class="exp__q">You're proofreading a deck for typos before a deadline. A colleague says one chart might be misleading. What helps most?</p>
            <div class="choices" data-choices>
              <button type="button" data-fb="Same lens, same blind spot. Faster isn't wider.">Read it again, faster</button>
              <button type="button" data-good data-fb="Yes. A separate pass with a new question points attention somewhere new.">Do a separate pass just for charts and logic</button>
              <button type="button" data-good data-fb="Also good. A different person with a different task sees different things.">Ask someone else to review with a checklist</button>
            </div>
            <p class="choices__fb" aria-live="polite"></p>
            <button class="btn" type="button" data-next hidden>Debrief <span class="arrow">→</span></button>
          </section>
          <section class="exp__panel" data-panel="3" hidden>
            <p class="exp__big">Next time you're deep in focus, ask: <em class="serif italic">"What am I not looking for?"</em></p>
            <p>That's why my modules change the question between passes: spot it, explain it, then decide with it.</p>
            <button class="btn btn--ghost" type="button" data-restart>↺ Run it again</button>
          </section>
        </>
      )}

      {id === 'memory' && (
        <>
          <section class="exp__panel" data-panel="0">
            <p class="exp__q">Remembering something vividly doesn't mean you remember it right.</p>
            <p>Eighteen words will flash, fast. Just read them. No notes, no rewinding.</p>
            <div class="flash" aria-live="polite"><span data-flash>Ready?</span></div>
            <button class="btn" type="button" data-flash-go data-words={JSON.stringify(words)}>▶ Show the words</button>
          </section>
          <section class="exp__panel" data-panel="1" hidden>
            <p class="exp__q">Which of these words did you see? Tap all that you remember.</p>
            <div class="probes">
              {probes.map((p) => <button type="button" class="probe" aria-pressed="false" data-seen={String(p.seen)} data-lure={p.lure ? 'true' : undefined}>{p.w}</button>)}
            </div>
            <button class="btn" type="button" data-check>Check my memory <span class="arrow">→</span></button>
          </section>
          <section class="exp__panel" data-panel="2" hidden>
            <p class="exp__big" data-mem-verdict></p>
            <p>This is <strong>reconstructive memory</strong>. Your brain stores the gist ("this is about sleep") and rebuilds details on recall. It fills gaps with what <em>should</em> have been there.</p>
            <p class="exp__cite mono">Based on the Deese–Roediger–McDermott paradigm (Roediger &amp; McDermott, 1995).</p>
            <button class="btn" type="button" data-next>So what? <span class="arrow">→</span></button>
          </section>
          <section class="exp__panel" data-panel="3" hidden>
            <p class="exp__big">Ask learners to <em class="serif italic">retrieve</em>, not just re-read, and give feedback fast.</p>
            <p>That's why my modules use recall questions, spaced recaps and "which detail did you assume?" checks, instead of one quiz at the end.</p>
            <button class="btn btn--ghost" type="button" data-restart>↺ Run it again</button>
          </section>
        </>
      )}
    </div>
  ))}
</div>

<style>
  .lab { margin-top: clamp(40px, 6vw, 72px); padding: clamp(24px, 4vw, 48px); border: 1.5px solid var(--ink); border-radius: 28px; background: var(--white); }
  .lab__head .h-lg em { font-weight: 400; color: var(--red); }
  .lab__tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 24px 0; }
  .lab__tabs button { font: 600 15px var(--display); padding: 10px 18px; border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; cursor: pointer; }
  .lab__tabs [aria-selected='true'] { background: var(--ink); color: var(--paper); }
  .exp__steps { list-style: none; display: flex; gap: 6px; padding: 0; margin: 0 0 24px; flex-wrap: wrap; }
  .exp__steps li { display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border-radius: 999px; background: var(--paper-2); font: 12px var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); transition: background 0.3s, color 0.3s; }
  .exp__steps li span { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--paper); font: italic 16px var(--serif); text-transform: none; }
  .exp__steps li.is-on { background: var(--red); color: var(--white); }
  .exp__steps li.is-on span { background: var(--white); color: var(--red); }
  /* both experiments keep the same height so switching tabs never shifts the page */
  .exp { min-height: 760px; }
  .exp__panel { display: grid; gap: 16px; max-width: 760px; }
  .exp__panel > .btn { justify-self: start; }
  @media (max-width: 760px) { .exp { min-height: 640px; } }
  .exp__panel p { margin: 0; }
  .exp__q { font: italic 400 clamp(22px, 2.2vw, 32px)/1.2 var(--serif); }
  .exp__big { font: 600 clamp(22px, 2.2vw, 30px)/1.25 var(--display); }
  .exp__cite { color: var(--ink-3); font-size: 11px; }
  .court { position: relative; aspect-ratio: 16 / 8; border-radius: 18px; background: #2c3a4a; overflow: hidden; }
  .pl { position: absolute; z-index: 1; width: 34px; height: 34px; border-radius: 50%; transform: translate(-50%, -50%); }
  .hole { position: absolute; z-index: 0; width: 6%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); background: #000; border: 2px dashed #9fb2c6; box-shadow: inset 0 4px 8px rgba(255, 255, 255, 0.08); }
  .pl--l { background: var(--paper); }
  .pl--d { background: #0d141c; border: 2px solid #4a5a6c; }
  /* sized in % of the court width so the near-misses with the holes stay near-misses at every screen size */
  .ball { position: absolute; z-index: 3; width: 2.2%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); background: var(--gold); }
  .ball--l { z-index: 6; box-shadow: 0 0 0 1.5px #fff6; }
  .ball--d { background: #6b7380; }
  .sneak { position: absolute; width: 64px; height: 64px; border-radius: 50%; left: -30%; top: 50%; z-index: 4; opacity: 0; background: radial-gradient(circle at 35% 30%, #fff6b0, #ffd400 45%, #e0a800); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35); }
  .court.is-running .sneak { opacity: 1; }
  .bnc { position: absolute; z-index: 3; width: 1.8%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); background: var(--red); left: -5%; }
  .bnc-1, .bnc-5 { background: var(--sage); } .bnc-2, .bnc-6 { background: #a7a3d6; width: 2.3%; } .bnc-3, .bnc-7 { background: var(--white); width: 1.4%; } .bnc-4 { background: #6f8cff; }
  .orb-0 { background: #ff7ad9; } .orb-1 { background: var(--sage); } .orb-2 { background: var(--white); }
  .lite { position: absolute; z-index: 2; width: 90px; height: 90px; border-radius: 50%; filter: blur(18px); opacity: 0; pointer-events: none; }
  .court.is-running .lite { animation: lite 1.3s ease-in-out infinite; }
  .lite-0 { left: 4%; top: 6%; background: var(--red); } .lite-1 { left: 30%; top: 70%; background: var(--gold); animation-delay: 0.3s !important; }
  .lite-2 { left: 62%; top: 8%; background: #6f8cff; animation-delay: 0.6s !important; } .lite-3 { left: 86%; top: 60%; background: var(--sage); animation-delay: 0.15s !important; }
  .lite-4 { left: 46%; top: 36%; background: #ff7ad9; animation-delay: 0.9s !important; } .lite-5 { left: 16%; top: 44%; background: #6f8cff; animation-delay: 0.45s !important; }
  .lite-6 { left: 74%; top: 30%; background: var(--gold); animation-delay: 1.05s !important; } .lite-7 { left: 54%; top: 76%; background: var(--red); animation-delay: 0.75s !important; }
  @keyframes lite { 0%, 100% { opacity: 0; } 50% { opacity: 0.55; } }
  .court__go { position: absolute; z-index: 7; white-space: nowrap; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--red); border-color: var(--red); }
  .exp__answer { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; }
  .exp__answer label { display: grid; gap: 6px; font-weight: 600; }
  .exp__answer input[type='number'] { width: 120px; padding: 10px 12px; border-radius: 10px; border: 1.5px solid var(--ink); font: 600 18px var(--display); background: var(--paper); }
  .exp__answer fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: 14px; align-items: center; }
  .exp__answer legend { font-weight: 600; margin-bottom: 6px; }
  .exp__answer fieldset label { display: flex; gap: 6px; font-weight: 400; }
  .choices { display: grid; gap: 8px; }
  .choices button, .probe { text-align: left; font: 500 16px var(--display); padding: 14px 18px; border-radius: 14px; border: 1.5px solid var(--ink); background: var(--paper); cursor: pointer; transition: background 0.2s, transform 0.3s var(--ease); }
  .choices button:hover, .probe:hover { transform: translateX(4px); }
  .choices button.is-good { background: var(--sage); }
  .choices button.is-meh { background: color-mix(in srgb, var(--red) 25%, var(--paper)); }
  .choices__fb { font-weight: 600; min-height: 1.5em; }
  .flash { height: 160px; display: grid; place-items: center; border-radius: 18px; background: var(--ink); color: var(--paper); font: 700 clamp(40px, 6vw, 72px) var(--display); font-variation-settings: 'wdth' 80; text-transform: uppercase; }
  .probes { display: flex; flex-wrap: wrap; gap: 10px; }
  .probe { text-align: center; min-width: 110px; }
  .probe[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .probe.is-lure { background: var(--red) !important; color: var(--white) !important; }
  .probe.is-right { outline: 3px solid var(--sage); }
</style>

<script>
  function setup(exp: HTMLElement) {
    const panels = Array.from(exp.querySelectorAll<HTMLElement>('[data-panel]'));
    const dots = Array.from(exp.querySelectorAll<HTMLElement>('[data-step-dot]'));
    const go = (i: number) => {
      panels.forEach((p, j) => (p.hidden = j !== i));
      dots.forEach((d, j) => d.classList.toggle('is-on', j <= i));
      panels[i].querySelector<HTMLElement>('button:not([hidden])')?.focus({ preventScroll: true });
    };
    exp.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) =>
      b.addEventListener('click', () => go(panels.indexOf(b.closest('[data-panel]') as HTMLElement) + 1)));
    exp.querySelectorAll<HTMLButtonElement>('[data-restart]').forEach((b) => b.addEventListener('click', () => reset()));

    const reset = () => {
      go(0);
      exp.querySelector<HTMLElement>('[data-after-run]')?.setAttribute('hidden', '');
      const run = exp.querySelector<HTMLElement>('[data-run]'); if (run) run.hidden = false;
      const fl = exp.querySelector<HTMLElement>('[data-flash-go]'); if (fl) fl.hidden = false;
      const f = exp.querySelector('[data-flash]'); if (f) f.textContent = 'Ready?';
      exp.querySelectorAll('.probe').forEach((p) => { p.setAttribute('aria-pressed', 'false'); p.classList.remove('is-lure', 'is-right'); });
      exp.querySelectorAll('.choices button').forEach((c) => c.classList.remove('is-good', 'is-meh'));
      const fb = exp.querySelector('.choices__fb'); if (fb) fb.textContent = '';
      const nx = exp.querySelector<HTMLElement>('[data-panel="2"] [data-next]'); if (nx && exp.dataset.exp === 'attention') nx.hidden = true;
    };

    // ── Attention: animated court ──
    const run = exp.querySelector<HTMLButtonElement>('[data-run]');
    if (run) {
      const court = exp.querySelector<HTMLElement>('.court')!;
      const L = [[18, 30], [42, 72], [70, 28]], D = [[30, 62], [58, 40], [84, 66]];
      const pls = court.querySelectorAll<HTMLElement>('.pl');
      [...L, ...D].forEach(([x, y], i) => { pls[i].style.left = x + '%'; pls[i].style.top = y + '%'; });
      const bl = court.querySelector<HTMLElement>('.ball--l')!, bd = court.querySelector<HTMLElement>('.ball--d')!;
      const place = (b: HTMLElement, p: number[]) => { b.style.left = p[0] + '%'; b.style.top = p[1] + '%'; };
      place(bl, L[0]); place(bd, D[0]);
      // holes (x%, y%). The gold ball skims past them but never touches: paths were checked for clearance
      // in units of court width, which is why the balls and holes are sized in % of the width.
      const H = [[44, 6], [36, 88], [64, 82], [90, 46], [8, 60]];
      court.querySelectorAll<HTMLElement>('.hole').forEach((h, i) => place(h, H[i]));
      // [to player, ms, skim point or null]. to === from is a fake that comes back (not a pass): 13 passes, 3 fakes.
      const seqL: [number, number, number[] | null][] = [
        [1, 900, null], [2, 700, null], [2, 900, [84, 41]], [0, 1100, [44, 17]], [1, 600, null],
        [1, 800, [37, 77]], [2, 800, null], [0, 700, null], [2, 1200, [20, 52]], [1, 600, null],
        [0, 900, null], [0, 800, [13, 51]], [1, 700, null], [2, 900, [59, 70]], [0, 500, null], [2, 600, null],
      ];
      const starts: number[] = []; seqL.reduce((acc, s) => (starts.push(acc), acc + s[1]), 0);
      const goldAt = (t: number) => {
        let k = starts.length - 1; while (k > 0 && starts[k] > t) k--;
        const from = k === 0 ? 0 : seqL[k - 1][0], [to, ms, skim] = seqL[k];
        const a = L[from], b = L[to], u = Math.min((t - starts[k]) / (ms * 0.75), 1);
        if (!skim) return [a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u - Math.sin(u * Math.PI) * 8];
        const c = [2 * skim[0] - (a[0] + b[0]) / 2, 2 * skim[1] - (a[1] + b[1]) / 2]; // curve passes the skim point halfway
        return [0, 1].map((j) => (1 - u) ** 2 * a[j] + 2 * (1 - u) * u * c[j] + u * u * b[j]);
      };
      const bnc = Array.from(court.querySelectorAll<HTMLElement>('.bnc:not(.orb)'));
      const orbs = Array.from(court.querySelectorAll<HTMLElement>('.orb'));
      run.addEventListener('click', () => {
        run.hidden = true;
        court.classList.add('is-running');
        const dur = 14000, t0 = performance.now();
        const sneak = court.querySelector<HTMLElement>('.sneak')!;
        const tick = (now: number) => {
          const t = now - t0;
          // light ball: the one to count
          place(bl, goldAt(t));
          // dark ball: faster, distracting
          const dk = Math.floor(t / 700) % 3, du = (t % 700) / 700, da = D[dk], db = D[(dk + 1) % 3];
          place(bd, [da[0] + (db[0] - da[0]) * du, da[1] + (db[1] - da[1]) * du]);
          // stray balls bouncing around the court
          bnc.forEach((el, i) => {
            const sp = 0.00016 + i * 0.00005, x = 6 + (((t * sp * 100) + i * 23) % 88);
            const y = 90 - Math.abs(Math.sin(t / (300 + i * 70) + i)) * (40 + (i % 4) * 10);
            place(el, [x, y]);
          });
          // decoys circling three holes, dipping toward the rim without dropping in
          orbs.forEach((el, i) => {
            const h = H[[1, 3, 4][i]], w = t / (520 + i * 140) + i * 2, r = 5 + 0.7 * Math.sin(t / 300 + i);
            place(el, [h[0] + r * Math.cos(w), h[1] + 2 * r * Math.sin(w)]);
          });
          // the sneak: a big yellow ball bounces across between 4 s and 9 s
          const s = Math.max(0, Math.min(1, (t - 4000) / 5000));
          sneak.style.left = `${-30 + s * 140}%`;
          sneak.style.top = `${78 - Math.abs(Math.sin(t / 260)) * 58}%`;
          sneak.style.transform = `translate(-50%, -50%) rotate(${t / 4}deg)`;
          if (t < dur) requestAnimationFrame(tick);
          else { court.classList.remove('is-running'); exp.querySelector<HTMLElement>('[data-after-run]')!.hidden = false; }
        };
        requestAnimationFrame(tick);
      });
      // verdict
      exp.querySelector('[data-panel="0"] [data-next]')!.addEventListener('click', () => {
        const n = (exp.querySelector<HTMLInputElement>('[data-count-input]')!.value || '').trim();
        const saw = exp.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value;
        exp.querySelector('[data-verdict]')!.textContent =
          (n ? `You counted ${n}${n === '13' ? '. Spot on.' : '.'} ` : '') +
          (saw === 'yes' ? 'You spotted the yellow ball. Your attention is either excellent or suspicious.' : saw === 'no' ? 'You missed the yellow ball. Most people do, and that is the point.' : '');
      });
      // application choices
      const fb = exp.querySelector<HTMLElement>('.choices__fb')!;
      exp.querySelectorAll<HTMLButtonElement>('.choices button').forEach((c) => c.addEventListener('click', () => {
        c.classList.add(c.hasAttribute('data-good') ? 'is-good' : 'is-meh');
        fb.textContent = c.dataset.fb ?? '';
        exp.querySelector<HTMLElement>('[data-panel="2"] [data-next]')!.hidden = false;
      }));
    }

    // ── Memory: flash words, then probe ──
    const flashGo = exp.querySelector<HTMLButtonElement>('[data-flash-go]');
    if (flashGo) {
      const out = exp.querySelector<HTMLElement>('[data-flash]')!;
      const list: string[] = JSON.parse(flashGo.dataset.words ?? '[]');
      flashGo.addEventListener('click', () => {
        flashGo.hidden = true;
        list.forEach((w, i) => setTimeout(() => (out.textContent = w), i * 560));
        setTimeout(() => { out.textContent = '…'; go(1); }, list.length * 560 + 400);
      });
      exp.querySelectorAll<HTMLButtonElement>('.probe').forEach((p) => p.addEventListener('click', () =>
        p.setAttribute('aria-pressed', String(p.getAttribute('aria-pressed') !== 'true'))));
      exp.querySelector('[data-check]')!.addEventListener('click', () => {
        let lured = false, right = 0;
        exp.querySelectorAll<HTMLElement>('.probe').forEach((p) => {
          const picked = p.getAttribute('aria-pressed') === 'true';
          if (p.dataset.lure) { p.classList.add('is-lure'); if (picked) lured = true; }
          else if (picked === (p.dataset.seen === 'true')) { right++; if (picked) p.classList.add('is-right'); }
        });
        exp.querySelector('[data-mem-verdict]')!.textContent = lured
          ? '"Sleep" was never on the list. You remembered it anyway. Welcome to the club.'
          : 'You resisted "sleep", which was never shown. Most people swear they saw it.';
        go(2);
      });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-exp]').forEach(setup);
  document.querySelectorAll<HTMLElement>('.lab').forEach((lab) => {
    const tabs = Array.from(lab.querySelectorAll<HTMLButtonElement>('.lab__tabs [role=tab]'));
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
        lab.querySelector<HTMLElement>(`[data-exp="${x.dataset.tab}"]`)!.hidden = !on; });
    }));
  });
</script>
