---
// Small line icons: ICAD steps and the interest easter eggs.
interface Props { name: string; size?: number }
const { name, size = 26 } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'spark' && <path d="M12 2v5M12 17v5M2 12h5M17 12h5M5 5l3.5 3.5M15.5 15.5 19 19M19 5l-3.5 3.5M8.5 15.5 5 19" />}
  {name === 'bulb' && <><path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2V16h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z" /></>}
  {name === 'hand' && <path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12m0-1V4.5a1.5 1.5 0 0 1 3 0V12m0-6.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-.6a6 6 0 0 1-4.6-2.2L3 16.3a1.6 1.6 0 0 1 2.4-2.1L8 16" />}
  {name === 'mirror' && <><circle cx="12" cy="9" r="6" /><path d="M12 15v6M9 21h6M9.5 6.5 11 8" /></>}
  {name === 'book' && <><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Z" /><path d="M4 19a2 2 0 0 1 2-2h13M9 7h6" /></>}
  {name === 'mountain' && <><path d="m2 20 7-12 4 6 3-4 6 10H2Z" /><path d="m7.5 10.5 1.5 1 1.5-1" /></>}
  {name === 'ball' && <><circle cx="12" cy="12" r="9" /><path d="M7 5.5c2 4 2 9 0 13M17 5.5c-2 4-2 9 0 13" stroke-dasharray="1.5 2" /></>}
  {name === 'knight' && <path d="M7 21h11M8 18h9l-1-6c2-1 3-3 2-5-1-3-4-4-7-3L7 9l2 1-1 3 3-1-3 6Z" />}
  {name === 'brain' && <path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 6 1V5a2 2 0 0 0-3-1Zm6 0a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-6 1" />}
  {name === 'quill' && <><path d="M20 4C12 4 6 10 5 19l-1 2" /><path d="M20 4c0 7-5 12-12 13M9 12h5" /></>}
  {name === 'coffee' && <><path d="M4 9h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z" /><path d="M16 11h2a2 2 0 0 1 0 4h-2M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3" /></>}
</svg>
