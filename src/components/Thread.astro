---
// "Pull the thread": a red thread hangs from the hero. Drag it down (or click / press Enter)
// and it snaps, sending you to the next section.
interface Props { target: string }
const { target } = Astro.props;
---
<div class="thread" data-thread={target}>
  <svg class="thread__svg" viewBox="0 0 60 200" aria-hidden="true" preserveAspectRatio="none">
    <path class="thread__line" d="M30 0 Q30 100 30 160" />
  </svg>
  <button class="thread__knob" type="button" aria-label="Pull the thread to start the session">
    <span class="thread__ball"></span>
    <span class="thread__label mono">Pull me</span>
  </button>
</div>

<style>
  .thread { position: absolute; left: 50%; top: 0; width: 60px; height: 200px; margin-left: -30px; z-index: 5; touch-action: none; }
  .thread__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .thread__line { fill: none; stroke: var(--red); stroke-width: 2.2; stroke-linecap: round; }
  .thread__knob {
    position: absolute; left: 50%; top: 160px; transform: translate(-50%, -50%);
    background: none; border: 0; padding: 0; cursor: grab; display: grid; justify-items: center; gap: 6px;
  }
  .thread__knob:active { cursor: grabbing; }
  .thread__ball { width: 22px; height: 22px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 6px color-mix(in srgb, var(--red) 18%, transparent); animation: tug 2.2s ease-in-out infinite; }
  .thread__label { font-size: 10px; color: var(--red); white-space: nowrap; }
  @keyframes tug { 0%, 70%, 100% { transform: translateY(0); } 80% { transform: translateY(8px); } 90% { transform: translateY(-2px); } }
  @media (max-width: 860px) { .thread { left: auto; right: 14%; } }
</style>
